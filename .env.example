# SKY ONE SOLUTION — environment template
# Copy to .env.local for local development. Set in Vercel → Project → Settings → Environment Variables.
# Do not commit secrets.

# --- Current (marketing site) ---
# NEXT_PUBLIC_SITE_URL=https://sky1usa.com

# --- Phase 1: Customer portal ---
# NEXT_PUBLIC_PORTAL_URL=https://portal.sky1usa.com
# DATABASE_URL=postgresql://...
# DIRECT_URL=postgresql://...
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Phase 2: WMS / integrations ---
# WMS_API_URL=
# WMS_API_KEY=
# S3_BUCKET=
# AWS_REGION=us-east-1

# --- Notifications ---
# RESEND_API_KEY=
# CONTACT_EMAIL=info@sky1usa.com

# --- Monitoring ---
# SENTRY_DSN=
